<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <AssemblyName>SprocketReferenceImages</AssemblyName><RootNamespace>SprocketReferenceImages</RootNamespace>
    <Version>0.1.2</Version><Authors>Nero</Authors><Company>Nero</Company><Copyright>Nero</Copyright><Product>Sprocket Reference Images</Product>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketReferenceImages/src</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sprocket</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\plugins\SprocketUiKit\SprocketUiKit.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\plugins\SprocketKeybinds\SprocketKeybinds.dll" Private="false" />
    <EmbeddedResource Include="model\reference-image-icon.png" LogicalName="reference-image-icon.png" />
    <EmbeddedResource Include="model\reference-board-*.stl" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets\no-image.png" LogicalName="no-image.png" />
  </ItemGroup>
</Project>
