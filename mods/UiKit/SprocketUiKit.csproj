<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><LangVersion>12</LangVersion><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget><Version>0.1.12</Version><AssemblyVersion>0.1.12.0</AssemblyVersion>
    <AssemblyName>SprocketUiKit</AssemblyName><RootNamespace>SprocketUiKit</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>Nero</Authors><Company>Nero</Company><Copyright>Nero</Copyright><Product>Sprocket UI Kit</Product>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sprocket</GameDir>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketUiKit/src</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;examples/**/*.cs;release/**;logs/**" />
    <Reference Include="SprocketKeybinds"><HintPath>$(GameDir)\BepInEx\plugins\SprocketKeybinds\SprocketKeybinds.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll"><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckSprocketGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(GameDir)\BepInEx\interop') Or !Exists('$(GameDir)\BepInEx\core\BepInEx.Core.dll')">
    <Error Text="GameDir '$(GameDir)' has no working Sprocket BepInEx 6 IL2CPP installation. Start the Sprocket Mod Loader once first." />
  </Target>
</Project>
