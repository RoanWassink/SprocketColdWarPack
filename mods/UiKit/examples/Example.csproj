<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sprocket</GameDir>
    <!-- The UI Kit DLL: by default the one built from this source (dotnet build -c Release in the folder above). A mod that only consumes the kit points this at $(GameDir)\BepInEx\plugins\SprocketUiKit\SprocketUiKit.dll. -->
    <UiKitDll Condition="'$(UiKitDll)' == ''">$(MSBuildThisFileDirectory)..\bin\Release\net6.0\SprocketUiKit.dll</UiKitDll></PropertyGroup>
  <ItemGroup>
    <Reference Include="SprocketUiKit"><HintPath>$(UiKitDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="SprocketKeybinds"><HintPath>$(GameDir)\BepInEx\plugins\SprocketKeybinds\SprocketKeybinds.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
