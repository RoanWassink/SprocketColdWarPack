<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>SprocketEngineExpansion</AssemblyName><RootNamespace>SprocketEngineExpansion</RootNamespace>
    <PlatformTarget>x64</PlatformTarget><Version>0.7.3</Version>
    <Authors>Nero</Authors><Company>Nero</Company><Copyright>Nero</Copyright><Product>Sprocket Engine Expansion</Product>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketEngineExpansion/src</PathMap>
    <IsPackable>false</IsPackable>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sprocket</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/*.meshbin" LogicalName="Powerpack.%(Filename)%(Extension)" />
    <!-- Test sources are excluded from compile, embedded resources, content, NuGet/pack and publish.
         Real-tank blueprint fixtures are not part of this tree (see README.md). -->
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="Audio/**/*.cs" />
    <Compile Remove="Geometry/**/*.cs" />
    <Compile Include="Geometry/PartState.cs;Geometry/AssemblyState.cs;Geometry/PartPersistence.cs" />
    <Compile Remove="Core/TubeGeometry.cs;Core/TurboHousingGeometry.cs;Core/MeshShape.cs;Core/GeometryAttempt.cs;Core/AssemblyRules.cs;Core/TerminalRules.cs" />
    <Reference Include="$(GameDir)/BepInEx/core/*.dll" Exclude="$(GameDir)/BepInEx/core/TerraFX*.dll;$(GameDir)/BepInEx/core/dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/BepInEx/interop/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>

