<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
    <Version>0.3.2</Version><AssemblyVersion>0.3.2.0</AssemblyVersion><LangVersion>11</LangVersion>
    <Authors>Nero</Authors><Company>Nero</Company><Copyright>Nero</Copyright><Product>Sprocket Sandbox Targets</Product>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketSandboxTargets/src</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameRoot Condition="'$(GameRoot)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Sprocket</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameRoot)/BepInEx/core/*.dll" Exclude="$(GameRoot)/BepInEx/core/TerraFX*.dll;$(GameRoot)/BepInEx/core/dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/BepInEx/interop/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
