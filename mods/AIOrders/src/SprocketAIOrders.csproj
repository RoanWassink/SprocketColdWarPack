<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
    <Version>0.5.4</Version>
    <Authors>Nero</Authors><Company>Nero</Company><Copyright>Nero</Copyright><Product>Sprocket AI Orders</Product>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketAIOrders/src</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <OutputPath>../build/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Sprocket</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/*.dll" Exclude="$(GameDir)/BepInEx/core/TerraFX*.dll;$(GameDir)/BepInEx/core/dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/BepInEx/interop/*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/BepInEx/plugins/SprocketKeybinds/SprocketKeybinds.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/BepInEx/plugins/SprocketUiKit/SprocketUiKit.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
