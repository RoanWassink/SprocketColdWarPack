<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketExpedition/src</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Nero</Authors>
    <Company>Nero</Company>
    <Copyright>Nero</Copyright>
    <Product>Sprocket Expedition</Product>
    <GameRoot Condition="'$(GameRoot)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Sprocket</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" Exclude="CampaignGameAdapter.cs;CustomBattleHostSpike.cs;CustomBattleBlueprintResolver.cs;CampaignPresenter.cs;CampaignControllerHost.cs;CampaignControllerHub.cs;CampaignFixtureCatalogue.cs;CampaignSlotManager.cs;CampaignSlotPolicy.cs;CampaignFactionDesigns.cs;CampaignNativeMenu.cs;CampaignMenuButton.cs;CampaignDesignerPlayHook.cs;CampaignResumePreparation.cs;CampaignNativeCatalogue.cs;CampaignCatalogueArchive.cs;CampaignMapPool.cs;CampaignVeteranStore.cs;CampaignFormationLabels.cs;CampaignDifficulty.cs" />
    <Reference Include="$(GameRoot)/BepInEx/core/*.dll" Exclude="$(GameRoot)/BepInEx/core/TerraFX*.dll;$(GameRoot)/BepInEx/core/dobby.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/BepInEx/interop/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(CampaignBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);CAMPAIGN</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CampaignBuild)' == 'true'">
    <Content Include="../../assets/audio/*.wav" Link="Audio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/audio/*.json;../../assets/audio/*.md" Link="Audio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="CampaignGameAdapter.cs" />
    <Compile Include="CustomBattleHostSpike.cs" />
    <Compile Include="CustomBattleBlueprintResolver.cs" />
    <Compile Include="CampaignPresenter.cs" />
    <Compile Include="CampaignControllerHost.cs" />
    <Compile Include="CampaignControllerHub.cs" />
    <Compile Include="CampaignFixtureCatalogue.cs" />
    <Compile Include="CampaignSlotManager.cs" />
    <Compile Include="CampaignSlotPolicy.cs" />
    <Compile Include="CampaignFactionDesigns.cs" />
    <Compile Include="CampaignNativeMenu.cs" />
    <Compile Include="CampaignMenuButton.cs" />
    <Compile Include="CampaignDesignerPlayHook.cs" />
    <Compile Include="CampaignResumePreparation.cs" />
    <Compile Include="UI/*.cs" />
    <!-- Shared Sprocket UI Kit (sprocket.uikit >=0.1.1 <0.2.0): referenced from the game, never shipped. -->
    <Reference Include="$(GameRoot)/BepInEx/plugins/SprocketUiKit/SprocketUiKit.dll">
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="../SprocketExpedition.Core/SprocketExpedition.Core.csproj">
      <Private>true</Private>
    </ProjectReference>
    <Compile Include="CampaignNativeCatalogue.cs" />
    <Compile Include="CampaignCatalogueArchive.cs" />
    <Compile Include="CampaignMapPool.cs" />
    <Compile Include="CampaignVeteranStore.cs" />
    <Compile Include="CampaignFormationLabels.cs" />
    <Compile Include="CampaignDifficulty.cs" />
  </ItemGroup>
</Project>

