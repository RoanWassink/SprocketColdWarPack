<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AssemblyName>SprocketPlateDestructionP0</AssemblyName><RootNamespace>PlateDestructionP0</RootNamespace>
    <Version>1.0.2</Version><Authors>Nero</Authors><Company>Nero</Company>
    <Description>Plate Destruction P0 1.0.0: whole-tank destruction toggle, Expanded Ballistics blast integration, true local-thickness localized blast holes, realistic behind-breach crew and internal module damage, InPlace armour updates.</Description>
    <GameDir Condition="'$(GameDir)'==''">E:\SteamLibrary\steamapps\common\Sprocket</GameDir>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketPlateDestructionP0/src</PathMap><DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll"><Private>false</Private></Reference>
    <Compile Remove="checks\**\*.cs;out\**\*.cs;obj\**\*.cs" />
  </ItemGroup>
</Project>
