<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget><Version>0.2.34</Version><AssemblyName>SprocketCarouselAutoloader</AssemblyName>
    <Authors>Nero</Authors><Company>Nero</Company><Copyright>Nero</Copyright><Product>Sprocket Carousel Autoloader</Product>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketCarouselAutoloader/src</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sprocket</GameDir>
    <UiKitDll Condition="'$(UiKitDll)' == ''">$(GameDir)\BepInEx\plugins\SprocketUiKit\SprocketUiKit.dll</UiKitDll>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Audio\t90.wav" LogicalName="Autoloaders.Audio.t90.wav" />
    <EmbeddedResource Include="Assets\Audio\t64.wav" LogicalName="Autoloaders.Audio.t64.wav" />
    <EmbeddedResource Include="Assets\Audio\bustle.wav" LogicalName="Autoloaders.Audio.bustle.wav" />
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll"><Private>false</Private></Reference>
    <!-- Optional HUD: soft dependency on the UI Kit, never shipped with Carousel. The ring needs the kit 0.1.8 API at
         compile time (build with -p:UiKitDll=<path to SprocketUiKit.dll> or -p:GameDir=<folder with the kit>); at runtime
         an older kit still works (bars). -->
    <Reference Include="$(UiKitDll)"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
