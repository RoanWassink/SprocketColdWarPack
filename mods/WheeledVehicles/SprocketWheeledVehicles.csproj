<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.4.3</Version>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Sprocket</GameDir>
    <Authors>Sprocket Wheeled Vehicles</Authors>
    <Company>Sprocket Wheeled Vehicles</Company>
    <Product>Sprocket Wheeled Vehicles</Product>
    <AssemblyName>SprocketWheeledVehicles</AssemblyName>
    <RootNamespace>SprocketWheeledVehicles</RootNamespace>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/SprocketWheeledVehicles/src</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="checks\**\*.cs" />
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
