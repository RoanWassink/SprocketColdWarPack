<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Authors>Nero</Authors>
    <Company>Nero</Company>
    <Version>1.0.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sprocket</GameDir>
    <KeybindsDll Condition="'$(KeybindsDll)' == ''">$(GameDir)\BepInEx\plugins\SprocketKeybinds\SprocketKeybinds.dll</KeybindsDll>
    <UiKitDll Condition="'$(UiKitDll)' == ''">$(GameDir)\BepInEx\plugins\SprocketUiKit\SprocketUiKit.dll</UiKitDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SprocketKeybinds"><HintPath>$(KeybindsDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="SprocketUiKit"><HintPath>$(UiKitDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
